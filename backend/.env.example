# Copy to .env in backend/. Pasted job descriptions can use local Ollama without a key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Required for web research and direct Ollama Cloud inference. Not needed for local inference.
OLLAMA_API_KEY=
DEFAULT_AI_PROVIDER=ollama
# Explicit opt-in: fallback may send resume prompts to another provider.
AI_FALLBACK_ENABLED=false
# Use a private random value before exposing authenticated services.
SECRET_KEY=replace-with-a-long-random-value
