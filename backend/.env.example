# Copy to .env in backend/. Pasted job descriptions can use local Ollama without a key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Required for web research and direct Ollama Cloud inference. Not needed for local inference.
OLLAMA_API_KEY=
DEFAULT_AI_PROVIDER=ollama
# Explicit opt-in: fallback may send resume prompts to another provider.
AI_FALLBACK_ENABLED=false
# Use a private random value before exposing authenticated services.
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Without SECRET_KEY, development sessions expire on restart; production must set it.

ENVIRONMENT=development
# For Supabase use Connect > Session pooler (port 5432), with a URL-encoded password.
# Keep this server-only. Never use a NEXT_PUBLIC_ variable for database credentials.
# DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# The app creates its tables and blocks direct client access through RLS on startup.
# The backend connection must own these tables. Keep your existing SECRET_KEY stable.
# DEMO_MODE=false
UPLOAD_DIR=./uploads/resumes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional email recovery/verification. Use your provider's verified sender and
# STARTTLS endpoint. Never commit real credentials. On Render, the public URL
# defaults to RENDER_EXTERNAL_URL; set FRONTEND_URL for a custom domain.
# FRONTEND_URL=https://your-app.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=verified-sender@example.com
# SMTP_TLS=true
# Production: set ENVIRONMENT=production and a stable SECRET_KEY.
# Register your personal account, then grant admin access locally with:
# python -m app.manage_admin your-registered-email@example.com
